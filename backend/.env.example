# 复制本文件为 backend/.env 并按需修改；.env 已被 .gitignore 排除，禁止提交
# 所有变量名均可直接作为环境变量使用

# ---- 服务基础 ----
# HOST=0.0.0.0
# PORT=8000

# ---- 日志（stdout + 文件双 sink，见 docs/RELIABILITY.md）----
# LOG_LEVEL=INFO          # DEBUG | INFO | WARN | ERROR，默认 INFO
# LOG_DIR=log             # 相对路径锚定 backend/，即落盘到 backend/log/
# LOG_FILE_NAME=app.log
# LOG_BACKUP_COUNT=30     # 按天轮转，保留最近 30 天

# ---- Provider 切换（业务代码无需修改）----
# DB_PROVIDER=sqlite          # sqlite | mysql
# VECTOR_STORE_PROVIDER=milvus # BE-029 起仅 milvus（Chroma 已删除）
# LLM_PROVIDER=ollama          # ollama | glm

# ---- 数据库 ----
# SQLITE_DB_PATH=data/law_agent.db
# MYSQL_URL=mysql://user:password@127.0.0.1:3306/law_agent

# ---- 向量数据库（默认优先使用 Milvus Cloud；本地 standalone 为显式回退）----
# VECTOR_STORE_PROVIDER=milvus
# 云端连接：Zilliz Cloud 的集群 Endpoint + API Key。
# 如果同时设置了下面两组变量，云端变量优先。
# MILVUS_CLOUD_URI=https://<cluster-endpoint>
# MILVUS_CLOUD_TOKEN=<zilliz-api-key>
# 本地 standalone 连接（仅在未设置云端变量时使用）：
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_TOKEN=
# MILVUS_COLLECTION_NAME=law_chunks  # 评测时改为独立集合，如 law_agent_eval

# ---- 大模型 ----
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-flash
# GLM_API_KEY=your-secret-key   # 敏感配置，只通过环境变量注入
# LLM_ENABLE_THINKING=false     # 思考模式开关（qwen3.5/glm-4.5 等推理模型），默认关闭以降低首字延迟

# ---- 规划器与 RAG 评测 Judge ----
# PLANNER_PROVIDER=follow        # follow | ollama | glm
# PLANNER_MODEL=                 # 空串表示使用所选 Provider 默认模型
# EVAL_JUDGE_PROVIDER=follow     # follow | ollama | glm
# EVAL_JUDGE_MODEL=              # 空串表示复用主 LLM；非空时启用独立 Judge

# ---- Agent 服务（rerank，BE-033）----
# 统一模型为 check_rerank_local.py 下载并验证的 MiniLM CrossEncoder。
# 首次使用先执行：uv run python scripts/check_rerank_model/check_rerank_local.py
# RERANK_ENABLED=false
# RERANKER_MODEL_PATH=../.model/cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_DEVICE=cpu

# ---- Langfuse 链路追踪（BE-043）----
# LANGFUSE_ENABLED=false          # true 开启 trace 上报（关闭时零导入零开销）
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # 或自托管实例地址
# LANGFUSE_PUBLIC_KEY=pk-lf-...   # 密钥只经 .env/环境注入，禁止提交仓库
# LANGFUSE_SECRET_KEY=sk-lf-...   # 开启但缺失时启动 WARN 降级为关闭，不阻断业务

# ---- Tavily Remote MCP 联网搜索（BE-048）----
# 联网搜索只有用户点击前端「联网搜索」按钮时才会触发；未配置 Key 时
# 应用仍可启动，点击后会显示“需要配置 TAVILY_API_KEY”。
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
# TAVILY_API_KEY=tvly-...          # 敏感配置，只通过环境变量注入，禁止提交
# TAVILY_SEARCH_DEPTH=basic        # basic | advanced（由 Tavily MCP 支持情况决定）
# TAVILY_MAX_RESULTS=5             # 5-20；默认最多返回 5 条
