# 复制本文件为 backend/.env 并按需修改；.env 已被 .gitignore 排除，禁止提交
# 所有变量名均可直接作为环境变量使用

# ---- 服务基础 ----
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO

# ---- Provider 切换（业务代码无需修改）----
# DB_PROVIDER=sqlite          # sqlite | mysql
# VECTOR_STORE_PROVIDER=chroma # chroma | milvus
# LLM_PROVIDER=ollama          # ollama | glm

# ---- 数据库 ----
# SQLITE_DB_PATH=data/law_agent.db
# MYSQL_URL=mysql://user:password@127.0.0.1:3306/law_agent

# ---- 向量数据库 ----
# CHROMA_PERSIST_DIR=data/chroma
# MILVUS_URI=http://127.0.0.1:19530

# ---- 大模型 ----
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-flash
# GLM_API_KEY=your-secret-key   # 敏感配置，只通过环境变量注入
# LLM_ENABLE_THINKING=false     # 思考模式开关（qwen3.5/glm-4.5 等推理模型），默认关闭以降低首字延迟
